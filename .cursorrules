### Pydantic Schemas

```python
from pydantic import BaseModel, EmailStr, Field, field_validator

class UsuarioCreate(BaseModel):
    """Schema para crear un nuevo usuario."""
    
    email: EmailStr
    password: str = Field(..., min_length=8, description="Contraseña del usuario")
    nombre: str = Field(..., min_length=3, max_length=255)
    rol: str = Field(default="reclutador", pattern="^(reclutador|administrador)$")
    
    @field_validator("password")
    @classmethod
    def validar_password_fortaleza(cls, v: str) -> str:
        """Valida que la contraseña tenga mayúsculas, minúsculas y números."""
        if not re.search(r"[A-Z]", v) or not re.search(r"[a-z]", v) or not re.search(r"\d", v):
            raise ValueError("La contraseña debe contener mayúsculas, minúsculas y números")
        return v
```

### Scripts SQL Comentados en Español

```sql
-- backend/src/models/sql/analisis.sql

-- Obtener todos los análisis con su puntaje y etiqueta
-- Retorna: id, cv_id, perfil_titulo, puntaje, etiqueta, analyzed_at
SELECT 
    a.id,
    a.cv_id,
    p.titulo AS perfil_titulo,
    a.puntaje,
    a.etiqueta,
    a.analyzed_at
FROM analisis a
JOIN perfil_cargo p ON a.perfil_id = p.id
WHERE a.analyzed_at >= :fecha_desde
ORDER BY a.puntaje DESC;

-- Insertar nuevo análisis
-- Parámetros: cv_id, perfil_id, puntaje, etiqueta, feedback, analyzed_by
INSERT INTO analisis (cv_id, perfil_id, puntaje, etiqueta, feedback, analyzed_at, analyzed_by)
VALUES (:cv_id, :perfil_id, :puntaje, :etiqueta, :feedback, NOW(), :analyzed_by)
RETURNING id;
```

