## 5. Robustez y Validación

### Try-Except Obligatorio

```python
# ✅ CORRECTO
async def analizar_cv(cv_id: int, perfil_id: int, db: Session) -> Analisis:
    """Analiza un CV contra un perfil de cargo."""
    try:
        cv = await obtener_cv_o_error(cv_id, db)
        perfil = await obtener_perfil_o_error(perfil_id, db)
        
        if not cv.extracted_text:
            raise ValueError("El CV no tiene texto extraído")
        
        puntaje = calcular_puntaje(cv, perfil)
        etiqueta = determinar_etiqueta(puntaje)
        feedback = generar_feedback(cv, perfil, puntaje)
        
        analisis = Analisis(
            cv_id=cv_id,
            perfil_id=perfil_id,
            puntaje=puntaje,
            etiqueta=etiqueta,
            feedback=feedback,
        )
        
        db.add(analisis)
        await db.commit()
        await db.refresh(analisis)
        
        return analisis
        
    except SQLAlchemyError as e:
        await db.rollback()
        logger.error(f"Error de base de datos al analizar CV {cv_id}: {e}")
        raise HTTPException(status_code=500, detail="Error al procesar el análisis")
    except ValueError as e:
        logger.warning(f"Error de validación para CV {cv_id}: {e}")
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        await db.rollback()
        logger.exception(f"Error inesperado al analizar CV {cv_id}")
        raise HTTPException(status_code=500, detail="Error interno del servidor")
```

### Validación Estricta de Inputs

```python
from pydantic import BaseModel, field_validator, Field
import re

class CVUploadRequest(BaseModel):
    """Request para upload de CVs."""
    
    files: list[UploadFile]
    
    @field_validator("files")
    @classmethod
    def validar_archivos(cls, v: list[UploadFile]) -> list[UploadFile]:
        """Valida tipo y tamaño de archivos."""
        if not v:
            raise ValueError("No se proporcionaron archivos")
        
        if len(v) > 50:
            raise ValueError("Máximo 50 archivos por lote")
        
        tipos_validos = {".pdf", ".docx", ".txt"}
        tamanio_maximo = 10 * 1024 * 1024  # 10MB
        
        for file in v:
            _, ext = os.path.splitext(file.filename or "")
            if ext.lower() not in tipos_validos:
                raise ValueError(f"Tipo de archivo no soportado: {ext}. Solo PDF, DOCX, TXT")
            
            # Validar tamaño (si es accesible)
            if file.size and file.size > tamanio_maximo:
                raise ValueError(f"Archivo {file.filename} excede 10MB")
        
        return v
```

