# Variables de entorno para CV Analyzer

# Aplicacion
SECRET_KEY=cambia-esta-clave-genera-una-nueva
DEBUG=True
APP_NAME=CV Analyzer
VERSION=0.1.0

# Base de datos
# Desarrollo (SQLite). La ruta se puede forzar con DB_PATH.
DATABASE_URL=sqlite:///./analizer.db
# DB_PATH=/app/data/analizer.db
# Produccion (PostgreSQL)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/cv_analyzer

# Timezone
TIMEZONE=America/Santiago

# Encriptacion de credenciales de portales (clave Fernet valida)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=cambia-esta-clave-de-encriptacion

# Administrador inicial (opcional: solo se crea si defines ambos valores)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=una-clave-larga-y-segura

# Sesiones
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=lax

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Upload de archivos
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=50
ALLOWED_FILE_TYPES=.pdf,.docx,.txt

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Proveedores de IA (opcional: sin clave se usan los analisis locales)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
