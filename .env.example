# Variables de entorno para AI-Recruiter Pro

# Aplicación
SECRET_KEY=tu-secret-key-aqui-genera-uno-nuevo
DEBUG=True
APP_NAME=AI-Recruiter Pro
VERSION=0.1.0

# Base de datos
# Desarrollo (SQLite)
DATABASE_URL=sqlite:///./dev.db
# Producción (PostgreSQL)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/ai_recruiter

# Timezone
TIMEZONE=America/Santiago

# Encriptación de credenciales de portales
CREDENTIAL_ENCRYPTION_KEY=tu-clave-de-encriptacion-aqui

# Sesiones
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=False  # True en producción con HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=lax

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Upload de archivos
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=50
ALLOWED_FILE_TYPES=.pdf,.docx,.txt

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
